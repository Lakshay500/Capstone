// Hack memory map: RAM16K, Screen and Keyboard.
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Decode the two high address bits in [14..13] order:
    // 00 and 01 = RAM16K (0..16383), 10 = Screen, 11 = Keyboard.
    DMux4Way(in=load, sel=address[14..13], a=loadRAM0, b=loadRAM1, c=loadScreen, d=loadKeyboard);
    Or(a=loadRAM0, b=loadRAM1, out=loadRAM);
    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=keyboardOut);
    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=keyboardOut, sel=address[14..13], out=out);
}
